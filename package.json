{
  "name": "dbark",
  "version": "0.7.0",
  "private": true,
  "description": "DBArk 开源数据库客户端",
  "license": "MIT",
  "author": "DBArk contributors",
  "main": "dist/main/index.cjs",
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "pnpm build && playwright test",
    "test:packaged": "node scripts/test-packaged.mjs",
    "dist": "pnpm build && electron-builder",
    "dist:win": "pnpm build && electron-builder --win --x64",
    "dist:mac": "pnpm build && electron-builder --mac --arm64 --x64"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "csv-parse": "^6.1.0",
    "csv-stringify": "^6.6.0",
    "iconv-lite": "^0.7.0",
    "lucide-react": "^0.577.0",
    "monaco-editor": "^0.55.1",
    "mysql2": "3.24.5",
    "react": "19.3.0",
    "react-data-grid": "7.0.0-beta.61",
    "react-dom": "19.3.0",
    "sql-formatter": "^15.6.10",
    "sql.js": "^1.13.0",
    "ssh2": "^1.17.0",
    "stream-json": "^1.9.1",
    "zod": "^4.1.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/sql.js": "^1.4.9",
    "@types/ssh2": "^1.15.5",
    "@types/stream-json": "^1.7.8",
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "44.7.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.9",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "com.dbark.desktop",
    "productName": "DBArk",
    "copyright": "Copyright © 2026 DBArk contributors",
    "directories": { "output": "release", "buildResources": "build" },
    "artifactName": "${productName}-${version}-${os}-${arch}-unsigned.${ext}",
    "npmRebuild": false,
    "files": ["dist/**/*", "package.json"],
    "extraResources": [{ "from": "node_modules/sql.js/dist/sql-wasm.wasm", "to": "sql-wasm.wasm" }, { "from": "build/icon.png", "to": "icon.png" }],
    "asarUnpack": ["node_modules/ssh2/**/*", "node_modules/cpu-features/**/*"],
    "win": { "target": ["nsis"], "icon": "build/icon.ico", "signExecutable": false },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "installerLanguages": ["zh_CN"] },
    "mac": { "target": ["dmg", "zip"], "icon": "build/icon.icns", "category": "public.app-category.developer-tools", "identity": "-" },
    "publish": null
  }
}
